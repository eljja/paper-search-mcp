openrhiza.com, www.openrhiza.com {
	# Empty glob keeps the legacy deployment unchanged. Opt-in OAuth routes:
	import oauth-enabled/*.caddy

	handle /mcp/paper-search* {
		basic_auth {
			smep-n {$PAPER_SEARCH_MCP_BASIC_AUTH_HASH}
		}

		rewrite * /mcp
		reverse_proxy 127.0.0.1:8765 {
			header_up Host 127.0.0.1:8765
			flush_interval -1
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
